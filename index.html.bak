            var h = ""; P.forEach(function (x, i) {
                var s = (x.n + " " + x.v + " " + x.c + " " + x.m).toLowerCase(); if (filter && x.c !== filter) return; if (term && s.indexOf(term) < 0) return;
                h += '<article class="p' + (i < 3 ? ' bk' : '') + '"><img class="d-only" src="' + ID[i] + '" alt="' + x.n + '"><img class="m-only" src="' + (i < 3 ? MI[i] : IM[i]) + '" alt="' + x.n + '"><span class="tag' + (x.t == "BESTSELLER" ? " b" : "") + '">' + x.t + '</span><button class="heart' + (wish[i] ? " on" : "") + '" data-i="' + i + '" aria-label="' + (wish[i] ? "Remove from" : "Add to") + ' wishlist: ' + x.n + '" aria-pressed="' + (wish[i] ? "true" : "false") + '">' + (wish[i] ? "♥" : "♡") + '</button><div class="pi"><h3>' + x.n + '</h3><div class="v">' + x.v + '</div><div class="pr">₹' + x.p.toLocaleString("en-IN") + '</div><div class="m">' + x.m + '</div><button type="button" class="add" data-i="' + i + '" aria-label="Add to Cart: ' + x.n + ', ' + x.v + '">Add to Cart</button></div></article>'
            });
            $("#grid").innerHTML = h || '<div class="empty">No products match. Try another search.</div>'
        }
        $("#grid").addEventListener("click", function (e) {
            var b = e.target.closest("button"); if (!b) return; var i = b.dataset.i;
            if (b.classList.contains("heart")) { toggleWish(i) } else if (b.classList.contains("add")) { addToCart(i, b) }
        });
        $("#q").addEventListener("input", function (e) { term = e.target.value.trim().toLowerCase(); filter = ""; render(); if (term) { if (location.hash == "#cart" || location.hash == "#wishlist") location.hash = "#new"; else $("#new").scrollIntoView() } });
        document.querySelectorAll(".cat").forEach(function (a) { a.addEventListener("click", function () { filter = a.dataset.f; term = ""; $("#q").value = ""; render() }) });
        $("#all").addEventListener("click", function (e) { e.preventDefault(); filter = ""; term = ""; $("#q").value = ""; render() });
        $("#ct").onclick = function () { var n = cartCount(); toast(n ? n + (n > 1 ? " items" : " item") + " in your cart" : "Your cart is empty") }; $("#wl").onclick = function () { toast("Tap ♡ on any product to save it") }; $("#fl").onclick = function () { toast("Filters coming soon") };
        $("#bg").onclick = function () { $("#dr").classList.toggle("on") }; document.querySelectorAll("#dr a").forEach(function (a) { a.onclick = function () { $("#dr").classList.remove("on") } });
        var sl = document.querySelectorAll(".sl"), dt = document.querySelectorAll("#dots b"), k = 0, tm, ms = document.querySelectorAll(".ms");
        function go(n) { sl[k].classList.remove("on"); dt[k].classList.remove("on"); k = (n + 3) % 3; sl[k].classList.add("on"); dt[k].classList.add("on"); document.querySelectorAll("[data-s]").forEach(function (e) { e.classList.toggle("on", e.dataset.s == k) }) }
        function auto() { clearInterval(tm); tm = setInterval(function () { go(k + 1) }, 5000) }
        $("#nx").onclick = function () { go(k + 1); auto() }; $("#pv").onclick = function () { go(k - 1); auto() }; dt.forEach(function (d, i) { d.onclick = function () { go(i); auto() } });
        auto(); loadCart(); updBadge(false); render();
        window.addEventListener("storage", function (e) { if (e.key === CK) { loadCart(); updBadge(false) } });
    </script>
    <script>(function () {
            var TH = ["data:image/webp;base64,", "data:image/webp;base64,", "data:image/webp;base64,", "data:image/webp;base64,", "data:image/webp;base64,", "data:image/webp;base64,"]; window.TH = TH; var X = { art: "data:image/webp;base64,", c32: TH[0], c33: TH[1], c34: TH[2], c35: TH[3], c36: TH[4], c37: TH[5] }; var k = document.querySelector(".bn.b2 img"); X.kurti = k ? k.src : ""; var lg = document.querySelector("header .logo img.brand");
            document.querySelectorAll("[data-img]").forEach(function (i) { i.src = X[i.dataset.img] });
            document.querySelectorAll("[data-logo]").forEach(function (i) { i.src = lg ? lg.src : "" });
        })();</script>
    <script>
        (function () {
            var TH = window.TH;
            var q = function (x, r) { return (r || document).querySelector(x) };
            function fmt(n) { return "\u20B9" + n.toLocaleString("en-IN") }
            function esc(t) { return String(t == null ? "" : t).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] }) }
            var cust = { name: "", phone: "", addr: "" };
            function view() { var h = location.hash; return h == "#cart" ? "cart" : h == "#wishlist" ? "wishlist" : "" }
            /* ---------- wishlist ---------- */
            function saveWish() { try { localStorage.setItem(WK, JSON.stringify(Object.keys(wish).filter(function (k) { return wish[k] }).map(Number))) } catch (e) { } }
            function wishCount() { return Object.keys(wish).filter(function (k) { return wish[k] }).length }
            window.updWish = function () { var n = wishCount(), b = q("#wc"); b.textContent = n; b.hidden = !n };
            window.toggleWish = function (i) { var on = !wish[i]; if (on) wish[i] = true; else delete wish[i]; saveWish(); updWish(); render(); if (view() == "wishlist") renderWish(); toast(on ? "Added to Wishlist \u2661" : "Removed from Wishlist") };
            /* ---------- cart ---------- */
            function flash(b) { if (!b || !b.classList || !(b.classList.contains("add") || b.classList.contains("add2"))) return; if (!b.dataset.t) b.dataset.t = b.textContent; b.textContent = "Added \u2713"; clearTimeout(b._h); b._h = setTimeout(function () { b.textContent = b.dataset.t; delete b.dataset.t }, 1000) }
            window.addToCart = function (i, b) { var id = "p" + i; cart[id] = Math.min((cart[id] || 0) + 1, 99); saveCart(); updBadge(true); toast("Added to Cart \u2713 \u00B7 " + P[i].n + " \u00D7" + cart[id]); flash(b || document.activeElement); if (view() == "cart") renderCart() };
            function items() { return Object.keys(cart).map(function (k) { var i = +k.slice(1); return { i: i, q: cart[k], p: P[i] } }).filter(function (x) { return x.p }) }
            function total() { return items().reduce(function (a, x) { return a + x.p.p * x.q }, 0) }
            function renderCart() {
                var it = items(), h = "";
                if (!it.length) { h = '<div class="vempty"><div class="em">&#10048;</div><h2>Your cart is empty</h2><p>Discover handcrafted Kalamkari sarees, kurtis and dupattas.</p><a class="btn" href="#new">Continue Shopping</a></div>' }
                else {
                    h = '<div class="cartwrap"><div class="clist">';
                    it.forEach(function (x) {
                        var p = x.p;
                        h += '<article class="ci2" data-i="' + x.i + '"><img src="' + TH[x.i] + '" alt="' + esc(p.n + " - " + p.v) + '" width="110" height="100"><div><h3>' + esc(p.n) + '</h3><div class="v">' + esc(p.v) + ' \u00B7 ' + esc(p.m) + '</div><div class="up">' + fmt(p.p) + ' each</div>'
                            + '<div class="qty" role="group" aria-label="Quantity"><button type="button" data-a="dec" aria-label="Decrease quantity of ' + esc(p.n) + '">\u2212</button><output aria-live="polite">' + x.q + '</output><button type="button" data-a="inc" aria-label="Increase quantity of ' + esc(p.n) + '">+</button></div></div>'
                            + '<div class="sub">Subtotal<b>' + fmt(p.p * x.q) + '</b></div>'
                            + '<div class="acts"><button type="button" class="lnk" data-a="wish">Move to Wishlist</button><button type="button" class="lnk rm" data-a="rm" aria-label="Remove ' + esc(p.n) + ' from cart">Remove</button></div></article>'
                    });
                    var n = it.reduce(function (a, x) { return a + x.q }, 0);
                    h += '</div><aside class="sum" aria-label="Order summary"><h2>Order Summary</h2><div class="srow2"><span>Items (' + n + ')</span><span>' + fmt(total()) + '</span></div><div class="srow2"><span>Delivery</span><span>Confirmed on WhatsApp</span></div><div class="stot"><span>Total</span><b>' + fmt(total()) + '</b></div>'
                        + '<p class="note">No online payment. Your order is sent to us on WhatsApp and we will confirm details and payment with you.</p>'
                        + '<label for="cn">Your name (optional)</label><input id="cn" autocomplete="name" value="' + esc(cust.name) + '">'
                        + '<label for="cp">Phone (optional)</label><input id="cp" type="tel" inputmode="tel" autocomplete="tel" value="' + esc(cust.phone) + '">'
                        + '<label for="ca">Delivery address (optional)</label><textarea id="ca" autocomplete="street-address">' + esc(cust.addr) + '</textarea>'
                        + '<button type="button" class="cta" data-a="checkout">Checkout on WhatsApp</button><a class="cta2" href="#new">Continue Shopping</a></aside></div>'
                }
                q("#v-cart .vbody").innerHTML = h
            }
            function renderWish() {
                var ks = Object.keys(wish).filter(function (k) { return wish[k] && P[k] }), h = "";
                if (!ks.length) { h = '<div class="vempty"><div class="em">&#9825;</div><h2>Your wishlist is empty</h2><p>Tap the heart on any piece you love and it will wait for you here.</p><a class="btn" href="#new">Continue Shopping</a></div>' }
                else {
                    h = '<div class="wgrid">'; ks.forEach(function (k) {
                        var p = P[k];
                        h += '<article class="wc" data-i="' + k + '"><img src="' + TH[k] + '" alt="' + esc(p.n + " - " + p.v) + '" width="308" height="228"><div class="in"><h3>' + esc(p.n) + '</h3><div class="v">' + esc(p.v) + '</div><div class="pr">' + fmt(p.p) + '</div><div class="btns2"><button type="button" class="add2" data-a="add">Add to Cart</button><button type="button" class="rm2" data-a="unwish" aria-label="Remove ' + esc(p.n) + ' from wishlist">\u2665 Remove</button></div></div></article>'
                    }); h += '</div>'
                }
                q("#v-wishlist .vbody").innerHTML = h
            }
            function checkout() {
                var it = items(); if (!it.length) { toast("Your cart is empty."); return }
                var L = ["Hello Purnima Kalamkari,", "", "I would like to place an order.", "", "Order Details:", ""];
                it.forEach(function (x, n) { L.push((n + 1) + ". " + x.p.n + " - " + x.p.v); L.push("Quantity: " + x.q); L.push("Price: " + fmt(x.p.p) + " each = " + fmt(x.p.p * x.q)); L.push("") });
                L.push("--------------------------------"); L.push("Total: " + fmt(total())); L.push("");
                L.push("Customer Name: " + cust.name); L.push("Phone: " + cust.phone); L.push("Delivery Address: " + cust.addr); L.push(""); L.push("Thank you.");
                var base = (q("a.wa").getAttribute("href") || "").split("?")[0];
                var url = base + "?text=" + encodeURIComponent(L.join("\n"));
                if (/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) { location.href = url }
                else { var w = window.open(url, "_blank", "noopener"); if (!w) location.href = url }
            }
            /* ---------- events (delegated, one listener each) ---------- */
            q("#v-cart").addEventListener("click", function (e) {
                var b = e.target.closest("button"); if (!b) return; var a = b.dataset.a; if (a == "checkout") { checkout(); return }
                var c = b.closest(".ci2"); if (!c) return; var i = c.dataset.i, id = "p" + i;
                if (a == "inc") { cart[id] = Math.min((cart[id] || 0) + 1, 99) }
                else if (a == "dec") { if ((cart[id] || 0) > 1) cart[id]--; else { delete cart[id]; toast("Item removed from Cart") } }
                else if (a == "rm") { delete cart[id]; toast("Item removed from Cart") }
                else if (a == "wish") { delete cart[id]; if (!wish[i]) { wish[i] = true; saveWish(); updWish(); render() } toast("Moved to Wishlist \u2661") }
                saveCart(); updBadge(a == "inc"); renderCart()
            });
            q("#v-cart").addEventListener("input", function (e) { var t = e.target; if (t.id == "cn") cust.name = t.value; else if (t.id == "cp") cust.phone = t.value; else if (t.id == "ca") cust.addr = t.value });
            q("#v-wishlist").addEventListener("click", function (e) {
                var b = e.target.closest("button"); if (!b) return; var c = b.closest(".wc"); if (!c) return; var i = c.dataset.i;
                if (b.dataset.a == "add") addToCart(i, b); else if (b.dataset.a == "unwish") toggleWish(i)
            });
            q("#ct").onclick = function () { location.hash = "#cart" };
            q("#wl").onclick = function () { location.hash = "#wishlist" };
            /* ---------- routing ---------- */
            var last = "";
            function route() {
                var v = view(); document.body.dataset.view = v || ""; if (!v) delete document.body.dataset.view;
                if (v) { if (v == "cart") renderCart(); else renderWish(); window.scrollTo({ top: 0, behavior: "instant" }) }
                else if (last) {
                    var h = location.hash, el = null; try { el = h.length > 1 ? q(h) : null } catch (e) { }
                    if (el) el.scrollIntoView(); else window.scrollTo({ top: 0, behavior: "instant" })
                }
                last = v || "home"; document.title = v == "cart" ? "Your Cart \u2013 Purnima Kalamkari" : v == "wishlist" ? "Your Wishlist \u2013 Purnima Kalamkari" : "Purnima Kalamkari \u2013 Handcrafted Kalamkari"
            }
            window.addEventListener("hashchange", route);
            window.addEventListener("storage", function (e) { if (e.key == WK) { try { var o = {}; JSON.parse(e.newValue || "[]").forEach(function (i) { if (P[i]) o[i] = true }); wish = o } catch (x) { } updWish(); render() } if (view() == "cart") renderCart() });
            updWish(); route(); last = view() || "home";
        })();
    </script>
    <script>(function () {
            var _r = render; render = function () { var f = filter, t = term; filter = ""; term = ""; _r(); var all = $("#grid").innerHTML; filter = f; term = t; _r(); $("#bgrid").innerHTML = all };
            $("#bgrid").addEventListener("click", function (e) { var b = e.target.closest("button"); if (!b) return; var i = b.dataset.i; if (b.classList.contains("heart")) toggleWish(i); else if (b.classList.contains("add")) addToCart(i, b) }); render()
        })();</script>
</body>

</html>