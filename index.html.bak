        /* ===== MOBILE LAYOUT (<=700px): compact, structured; desktop untouched ===== */
        @media(max-width:700px) {
            .x {
                padding-left: 16px;
                padding-right: 16px
            }

            .fc {
                display: flex;
                flex-wrap: nowrap;
                align-items: flex-start;
                gap: 8px;
                overflow-x: auto;
                margin: 4px -14px 22px;
                padding: 11px 14px 8px;
                scroll-snap-type: x proximity;
                scroll-padding-left: 14px;
                scrollbar-width: none;
                -webkit-overflow-scrolling: touch;
                overscroll-behavior-x: contain
            }

            .fc::-webkit-scrollbar {
                display: none
            }

            .fc a {
                flex: 0 0 84px;
                aspect-ratio: auto;
                background: none;
                box-shadow: none;
                border-radius: 0;
                overflow: visible;
                text-align: center;
                scroll-snap-align: start
            }

            .fc a::after {
                display: none
            }

            .fc img {
                position: static;
                width: 72px;
                height: 72px;
                margin: 0 auto 9px;
                border-radius: 50%;
                box-shadow: 0 0 0 2.5px #f8f5e6, 0 0 0 4px #c9a15c
            }

            .fc .cap {
                position: static;
                display: block;
                color: var(--ink)
            }

            .fc .cap b {
                display: block;
                font-size: 12.5px;
                line-height: 1.25;
                text-shadow: none
            }

            .fc .cap small,
            .fc .go {
                display: none
            }

            #best {
                padding-bottom: 6px
            }

            #best .grid {
                margin-bottom: 26px
            }

            /* About: image beside the heading block, copy below */
            #story {
                padding-top: 26px;
                padding-bottom: 28px
            }

            .ab {
                grid-template-columns: minmax(0, 42%) minmax(0, 1fr);
                grid-template-rows: auto auto 1fr;
                gap: 0 16px;
                align-items: start
            }

            .ab-c,
            .ab-tx {
                display: contents
            }

            .ab-img {
                grid-column: 1;
                grid-row: 1/4;
                margin: 0 0 0 6px
            }

            .ab-img::before {
                left: -6px;
                top: -6px;
                right: 6px;
                bottom: 6px;
                border-width: 1.5px
            }

            .ab-img img {
                aspect-ratio: 3/4;
                object-position: 50% 12%;
                border-radius: 10px
            }

            .ab .x-eyebrow,
            .ab .x-t,
            .ab .ab-q {
                grid-column: 2
            }

            .ab .x-eyebrow {
                font-size: 10px;
                letter-spacing: .1em;
                line-height: 1.5;
                margin: 2px 0 6px;
                align-self: start
            }

            .ab .x-t {
                font-size: 22px;
                line-height: 1.2;
                margin: 0 0 10px;
                align-self: start
            }

            .ab .ab-q {
                font-size: 13.5px;
                line-height: 1.5;
                margin: 0;
                padding-left: 10px;
                align-self: start
            }

            .ab p.tx,
            .ab .feats,
            .ab .btn {
                grid-column: 1/-1
            }

            .ab .feats {
                order: 1;
                grid-template-columns: repeat(2, minmax(0, 1fr))
            }

            .ab .btn {
                order: 2
            }

            .ab p.tx {
                font-size: 14px;
                line-height: 1.7;
                margin: 0 0 10px
            }

            .ab .ab-q+p.tx {
                margin-top: 20px
            }

            .stats {
                gap: 8px;
                margin: 14px 0 16px
            }

            .stats div {
                padding: 11px 4px
            }

            .stats b {
                font-size: 19px
            }

            .stats span {
                font-size: 11px
            }

            /* From Nature to Fabric: 3 round cards per row */
            #craft {
                padding-top: 30px;
                padding-bottom: 30px
            }

            #craft .x-t {
                font-size: 24px;
                margin-bottom: 8px
            }

            #craft .x-sub {
                font-size: 14px;
                max-width: 300px;
                margin: 0 auto
            }

            #craft .x-orn {
                margin-top: 12px;
                max-width: 200px
            }

            .pr6 {
                --c: clamp(78px, 26vw, 112px);
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 22px 8px;
                margin-top: 22px
            }

            .pr6 .ci {
                width: var(--c);
                max-width: none;
                margin: 0 auto 10px;
                border-width: 2px;
                box-shadow: 0 0 0 3px #fdf6ea, 0 4px 12px rgba(70, 35, 25, .18)
            }

            .pr6 .n {
                left: calc(50% - var(--c)/2 - 4px);
                top: -4px;
                margin: 0;
                transform: none;
                width: 22px;
                height: 22px;
                font: 700 10.5px/22px var(--sans)
            }

            .pr6 h3 {
                font-size: 13.5px;
                line-height: 1.25;
                margin: 0 0 4px;
                min-height: 2.5em;
                display: flex;
                align-items: flex-start;
                justify-content: center
            }

            .pr6 p {
                font-size: 11px;
                line-height: 1.4;
                max-width: none;
                padding: 0 2px
            }

            /* Store: image beside heading + intro, details below */
            #store {
                padding-top: 22px;
                padding-bottom: 28px
            }

            .stc {
                grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
                gap: 0 14px;
                padding: 14px;
                align-items: start
            }

            .stc>.bd {
                display: contents
            }

            .stc .im {
                grid-column: 1;
                grid-row: 1/4;
                min-height: 0;
                align-self: stretch;
                border-radius: 10px;
                overflow: hidden
            }

            .stc .im img {
                object-position: 38% 20%
            }

            .stc .x-eyebrow,
            .stc .x-t,
            .stc p.tx {
                grid-column: 2
            }

            .stc .x-eyebrow {
                font-size: 10px;
                letter-spacing: .2em;
                margin: 0 0 6px
            }

            .stc .x-t {
                font-size: 21px;
                margin: 0 0 8px
            }

            .stc p.tx {
                font-size: 13.5px;
                line-height: 1.6;
                margin: 0
            }

            .stc .info,
            .stc .btns {
                grid-column: 1/-1
            }

            .stc .row {
                font-size: 14px;
                margin: 0 0 8px
            }

            .stc .info {
                margin-top: 16px
            }

            .btns {
                gap: 10px;
                margin-top: 14px;
                flex-wrap: nowrap
            }

            .btns a {
                flex: 1 1 0;
                min-width: 0;
                padding: 10px 8px;
                font-size: 13px;
                text-align: center
            }

            /* Footer: structured two-column grid */
            footer.ft {
                padding: 30px 18px 0
            }

            .ft-g {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 26px 18px
            }

            .ft-g>div:first-child {
                grid-column: 1/-1;
                display: grid;
                grid-template-columns: auto minmax(0, 1fr);
                gap: 0 16px;
                align-items: center;
                padding-bottom: 22px;
                border-bottom: 1px solid #ffffff22
            }

            .ft .ft-logo {
                margin: 0
            }

            .ft .ft-logo img {
                width: clamp(96px, 30vw, 128px)
            }

            .ft p {
                font-size: 13.5px;
                line-height: 1.6
            }

            .ft h4 {
                font-size: 17px;
                margin: 0 0 12px;
                padding-bottom: 8px;
                border-bottom: 1px solid #d9b36b55
            }

            .ft ul {
                gap: 9px
            }

            .ft li,
            .ft li a {
                font-size: 14px
            }

            .ft .soc {
                border-top: 1px solid #ffffff22;
                padding-top: 22px
            }

            .ft .si a {
                width: 40px;
                height: 40px
            }

            .ft-b {
                margin-top: 22px;
                padding: 14px 0 18px;
                flex-direction: column;
                align-items: center;
                text-align: center;
                gap: 4px;
                font-size: 12px
            }

            /* section headers stay on one line */
            .sh {
                gap: 8px
            }

            .sh h2 {
                white-space: nowrap
            }

            .sh a {
                white-space: nowrap
            }
        }

        @media(max-width:359px) {
            .ab {
                grid-template-columns: minmax(0, 40%) minmax(0, 1fr);
                gap: 0 12px
            }

            .ab .x-t,
            .stc .x-t {
                font-size: 18px
            }

            .ab .ab-q {
                font-size: 12.5px
            }

            .stc p.tx {
                font-size: 12.5px
            }

            .pr6 h3 {
                font-size: 12.5px
            }

            .pr6 p {
                font-size: 10.5px
            }

            .ft li,
            .ft li a {
                font-size: 13px
            }

            .ft-g {
                gap: 22px 12px
            }

            .ft .ft-logo img {
                width: 92px
            }

            .sh h2 {
                font-size: 18px
            }

            .sh a {
                font-size: 10.5px
            }

            .ab .x-eyebrow {
                font-size: 9px;
                letter-spacing: .06em
            }
        }

        /* ===== Bestsellers / Art / decorations / footer extras ===== */
        #best {
            padding-bottom: clamp(30px, 4vw, 56px)
        }

        .ab .btn {
            margin-top: 4px
        }

        .feats {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: 1fr;
            gap: 18px
        }

        .feats li {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: var(--serif);
            font-size: clamp(13px, 1.1vw, 15px);
            line-height: 1.35;
            color: #4a3a30
        }

        .feats i {
            flex: none;
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center
        }

        .feats svg {
            width: 30px;
            height: 30px;
            stroke: var(--maroon);
            fill: none;
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-linejoin: round
        }

        .ft .si {
            display: flex;
            flex-wrap: wrap;
            gap: 12px
        }

        .ft .si a {
            width: 38px;
            height: 38px;
            border: 1px solid #d9b36b88;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #d9b36b;
            transition: .2s
        }

        .ft .si a:hover {
            background: #d9b36b;
            color: #2b1c18
        }

        .ft .ct li a.free {
            color: #d9b36b
        }

        @media(max-width:700px) {
            .ab .feats {
                margin: 18px 0 0;
                gap: 12px 10px
            }

            .feats li {
                font-size: 12.5px;
                gap: 9px
            }

            .feats i {
                width: 36px;
                height: 36px
            }

            .feats svg {
                width: 18px;
                height: 18px
            }

            .ab .btn {
                width: 100%;
                font-size: 14px;
                text-align: center;
                padding: 12px
            }
        }

        /* ===== Reference match: Art / Process / Store ===== */
        .b-r {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 13px 24px;
            border-radius: 4px;
            font-weight: 700;
            font-size: 14px;
            min-height: 46px;
            background: var(--maroon);
            color: #fff
        }

        .b-r:hover {
            background: #5f0e13
        }

        .stc .info {
            display: grid;
            gap: 10px
        }

        .stc .row small {
            color: var(--mute);
            font-size: .88em
        }

        .stc .row svg {
            width: 22px;
            height: 22px
        }

        @media(min-width:701px) {
            #story {
                padding: 0;
                background: #f6ead8
            }
        }

        @media(min-width:701px) {
            #story {
                padding-left: 0;
                padding-right: 0
            }

            #story .x-in {
                max-width: none
            }

            .ab {
                grid-template-columns: 46% 1fr;
                gap: 0;
                align-items: stretch
            }

            .ab-img::before {
                display: none
            }

            .ab-img {
                min-height: 380px;
                z-index: auto
            }

            .ab-img img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                aspect-ratio: auto;
                border-radius: 0;
                box-shadow: none;
                object-position: 50% 14%
            }

            .ab-c {
                display: grid;
                grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
                gap: clamp(18px, 2.6vw, 40px);
                align-items: center;
                padding: clamp(28px, 4vw, 56px) 5.4% clamp(28px, 4vw, 56px) clamp(24px, 3.4vw, 52px)
            }

            .ab .x-t {
                font-size: clamp(26px, 2.7vw, 40px)
            }

            .feats li {
                font-size: clamp(12.5px, 1vw, 14.5px)
            }

            .feats i {
                width: 44px
            }

            .feats svg {
                width: 34px;
                height: 34px;
                stroke-width: 1.2
            }

            .pr6 .st {
                display: grid;
                grid-template-columns: auto 1fr;
                grid-template-areas: "n h" "i i" "p p";
                align-items: center;
                column-gap: 8px;
                background: #f4e7d3;
                border-radius: 12px;
                padding: 12px 12px 14px;
                text-align: center
            }

            .pr6 .n {
                position: static;
                grid-area: n;
                width: auto;
                height: auto;
                margin: 0;
                transform: none;
                background: none;
                box-shadow: none;
                color: #6b4a2a;
                font: 500 clamp(20px, 2vw, 28px)/1 var(--serif)
            }

            .pr6 h3 {
                grid-area: h;
                text-align: left;
                margin: 0;
                font-size: clamp(12px, 1.1vw, 15px);
                font-weight: 500;
                line-height: 1.2
            }

            .pr6 .ci {
                grid-area: i;
                width: 100%;
                max-width: none;
                aspect-ratio: 4/3;
                border: 0;
                border-radius: 10px;
                box-shadow: none;
                margin: 10px 0 10px
            }

            .pr6 p {
                grid-area: p;
                font-size: clamp(11.5px, .95vw, 13.5px);
                max-width: none
            }

            .pr6 .st:hover .ci {
                transform: none
            }

            .pr6 .ci img {
                transition: transform .5s
            }

            .pr6 .st:hover .ci img {
                transform: scale(1.05)
            }

            .stc {
                grid-template-columns: 1fr 1.15fr;
                border-radius: 0;
                border-left: 0;
                border-right: 0;
                box-shadow: none;
                background: #fbf1de
            }

            .stc .bd {
                display: flex;
                flex-direction: column;
                justify-content: center
            }

            .stc .x-t {
                font-size: clamp(26px, 3vw, 40px)
            }
        }

        @media(min-width:1001px) {
            .pr6 .st:not(:last-child)::after {
                content: "\203A";
                position: absolute;
                right: calc(var(--g)/-2 - 5px);
                top: 50%;
                color: #b88a3e;
                font-size: 20px;
                line-height: 1
            }

            .stc .info {
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 14px
            }

            .stc .row {
                margin: 0
            }
        }

        @media(max-width:700px) {
            .pr6 .n {
                font: 700 9.5px/22px var(--sans)
            }
        }

        @media(max-width:700px) {
            .ab .btn {
                margin-top: 18px
            }
        }
    </style>
    <style id="ref-fix">
        /* ===== Targeted reference fixes: Art (mobile), Process (all), Store image (mobile) ===== */
        /* Process - shared: left-aligned header like reference, 5 steps */
        #craft {
            text-align: left
        }

        #craft .x-eyebrow,
        #craft .x-orn {
            display: none
        }

        #craft .x-t {
            margin: 0 0 4px
        }

        #craft .x-sub {
            margin: 0;
            max-width: none
        }

        @media(min-width:701px) {
            .pr6 {
                grid-template-columns: repeat(5, minmax(0, 1fr));
                margin-top: 22px
            }

            .pr6 .st {
                background: #f4e7d3;
                border: 1px solid #eadcc4
            }

            .pr6 .st {
                align-items: start;
                align-content: start
            }

            .pr6 .ci {
                aspect-ratio: 300/184;
                margin: 10px 0
            }

            .pr6 .ci img {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: cover
            }

            .pr6 h3 {
                align-self: center
            }

            .pr6 p {
                align-self: start
            }

            .pr6 .st:not(:last-child)::after {
                display: none
            }
        }

        @media(min-width:1001px) {
            .pr6 .st:not(:last-child)::after {
                display: block;
                right: calc(var(--g)/-2 - 5px)
            }
        }

        @media(max-width:700px) {
            #craft {
                padding-top: 22px;
                padding-bottom: 22px
            }

            #craft .x-t {
                font-size: 22px;
                margin-bottom: 6px
            }

            #craft .x-sub {
                font-size: 13px;
                max-width: none
            }

            .pr6 {
                --g: 6px;
                grid-template-columns: repeat(5, minmax(0, 1fr));
                gap: 0 var(--g);
                margin-top: 16px
            }

            .pr6 .st {
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
                background: none;
                padding: 0
            }

            .pr6 .ci {
                order: 1;
                width: 100%;
                max-width: 64px;
                aspect-ratio: 1;
                margin: 0 auto 6px;
                border: 2px solid #c9a15c;
                box-shadow: 0 0 0 2px #fdf6ea
            }

            .pr6 .n {
                order: 2;
                position: static;
                display: block;
                width: auto;
                height: auto;
                margin: 0 0 2px;
                transform: none;
                background: none;
                box-shadow: none;
                color: #6b4a2a;
                font: 600 10.5px/1.2 var(--sans)
            }

            .pr6 h3 {
                order: 3;
                display: block;
                min-height: 0;
                margin: 0;
                font: 500 10.5px/1.25 var(--sans);
                color: var(--ink);
                text-align: center
            }

            .pr6 p {
                display: none
            }
        }

        @media(max-width:359px) {
            .pr6 h3 {
                font-size: 9.5px
            }

            .pr6 .n {
                font-size: 9.5px
            }
        }

        /* Art - mobile composition: heading on top, image left / text right, button under text */
        @media(max-width:700px) {
            .ab {
                grid-template-columns: minmax(0, 42%) minmax(0, 1fr);
                grid-template-rows: auto auto auto auto auto auto;
                gap: 0 14px;
                align-items: start
            }

            .ab .x-eyebrow {
                grid-column: 1/-1;
                grid-row: 1;
                margin: 0 0 4px;
                font-size: 10px
            }

            .ab .x-t {
                grid-column: 1/-1;
                grid-row: 2;
                font-size: 24px;
                line-height: 1.15;
                margin: 0 0 12px
            }

            .ab-img {
                grid-column: 1;
                grid-row: 3/6;
                margin: 0;
                align-self: start
            }

            .ab-img::before {
                display: none
            }

            .ab-img img {
                aspect-ratio: 4/5;
                object-fit: cover;
                object-position: 50% 12%;
                border-radius: 10px;
                box-shadow: 0 6px 16px rgba(70, 35, 25, .18)
            }

            .ab .ab-q {
                grid-column: 2;
                grid-row: 3;
                font-size: 14px;
                margin: 0 0 8px;
                padding-left: 10px
            }

            .ab .ab-q+p.tx,
            .ab p.tx {
                grid-column: 2;
                grid-row: 4;
                font-size: 12.5px;
                line-height: 1.55;
                margin: 0 0 12px
            }

            .ab .btn {
                grid-column: 2;
                grid-row: 5;
                width: 100%;
                margin: 0;
                padding: 10px 8px;
                font-size: 12.5px;
                order: 0;
                align-self: start
            }

            .ab .feats {
                display: none !important
            }
        }

        /* Store - mobile: title on top, image fills left column beside text (no empty space under image) */
        @media(max-width:700px) {
            .stc {
                grid-template-columns: minmax(0, 48%) minmax(0, 1fr);
                grid-template-rows: auto auto auto auto auto auto auto;
                gap: 0 12px;
                padding: 12px;
                align-items: start
            }

            .stc .x-eyebrow {
                grid-column: 1/-1;
                grid-row: 1;
                font-size: 9.5px;
                letter-spacing: .16em;
                margin: 0 0 4px;
                white-space: nowrap
            }

            .stc .x-t {
                grid-column: 1/-1;
                grid-row: 2;
                font-size: 22px;
                line-height: 1.2;
                margin: 0 0 10px
            }

            .stc .im {
                grid-column: 1;
                grid-row: 3/6;
                align-self: stretch;
                aspect-ratio: auto;
                min-height: 0;
                border-radius: 10px;
                overflow: hidden
            }

            .stc .im img {
                object-fit: cover;
                object-position: 52% 30%
            }

            .stc p.tx {
                grid-column: 2;
                grid-row: 3;
                font-size: 12.5px;
                line-height: 1.5;
                margin: 0 0 10px
            }

            .stc .info {
                display: contents
            }

            .stc .info .row:nth-child(1) {
                grid-column: 2;
                grid-row: 4;
                margin: 0 0 8px
            }

            .stc .info .row:nth-child(2) {
                grid-column: 2;
                grid-row: 5;
                margin: 0
            }

            .stc .info .row:nth-child(3) {
                grid-column: 1/-1;
                grid-row: 6;
                margin: 12px 0 0
            }

            .stc .info .row:nth-child(-n+2) {
                font-size: 12.5px;
                gap: 8px;
                line-height: 1.35
            }

            .stc .info .row:nth-child(-n+2) svg {
                width: 18px;
                height: 18px
            }

            .stc .btns {
                grid-column: 1/-1;
                grid-row: 7;
                margin-top: 14px
            }
        }

        @media(max-width:359px) {
            .stc {
                grid-template-columns: minmax(0, 46%) minmax(0, 1fr);
                gap: 0 10px;
                padding: 10px
            }

            .stc .x-eyebrow {
                font-size: 8.5px;
                letter-spacing: .1em
            }

            .stc .x-t {
                font-size: 19px
            }

            .stc p.tx,
            .stc .info .row:nth-child(-n+2) {
                font-size: 11.5px
            }

            .btns a {
                font-size: 11.5px;
                padding: 10px 4px;
                white-space: nowrap
            }
        }

        /* Store mobile: image fills full height beside heading+intro, ends right above the location row */
        @media(max-width:700px) {
            .stc .im {
                aspect-ratio: auto;
                align-self: stretch;
                min-height: 140px
            }

            .stc .im img {
                object-position: 55% 22%
            }
        }

        /* Store mobile: phone row removed, image fills the block beside intro/address/hours */
        @media(max-width:700px) {
            .stc .info .row:nth-child(3) {
                display: none !important
            }

            .stc .im {
                align-self: stretch;
                aspect-ratio: auto;
                min-height: 150px
            }

            .stc .im img {
                object-fit: cover;
                object-position: 50% 18%
            }
        }
    </style>
</head>

<body>
    <div class="top">
        <div class="wrap">
            <div class="l"><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff"
                        stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 6h12v10H2zM14 10h4l3 3v3h-7" />
                        <circle cx="7" cy="18" r="2" />
                        <circle cx="17" cy="18" r="2" />
                    </svg>Handcrafted Kalamkari</span><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                        stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 8l9-5 9 5v8l-9 5-9-5zM3 8l9 5 9-5M12 13v8" />
                    </svg>Free Pan India Delivery</span><span><svg width="14" height="14" viewBox="0 0 24 24"
                        fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 21s-7-5.500-7-11a7 7 0 0 1 14 0c0 5.500-7 11-7 11z" />
                        <circle cx="12" cy="10" r="2.500" />
                    </svg>Visit Our Store in Pedana, Andhra Pradesh</span><span><svg width="14" height="14"
                        viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M3 21l1.600-4.800A8.500 8.500 0 1 1 8 19.500z" />
                    </svg>WhatsApp Us: +91 98765 43210</span></div>
            <div class="r">Follow Us: <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff"
                    stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                </svg><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7"
                    stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" fill="#fff" stroke="none" />
                </svg></div>
        </div>
        <div class="mb"><span>‹</span><span>🚚 Free Pan India Delivery</span><span>›</span></div>
    </div>
    <header>
        <div class="hd">
            <button class="ic burger m-only" id="bg" aria-label="Menu"><svg viewBox="0 0 24 24">
                    <path d="M3 6h18M3 12h18M3 18h18" />
                </svg></button>
            <a href="#" class="logo" aria-label="Purnima Kalamkari - Home"><img class="brand"
                    src="data:image/webp;base64,"
                    alt="Purnima Kalamkari - Handcrafted, Heritage, Heartfelt" width="560" height="565"
                    decoding="async"></a>
            <div class="mid">
                <div class="srow">
                    <div class="search"><svg class="m-only" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="#2a1a14" stroke-width="1.8">
                            <circle cx="11" cy="11" r="7" />
                            <path d="m20 20-4-4" />
                        </svg><input id="q" type="search" placeholder="Search sarees, kurtis, dupattas..."
