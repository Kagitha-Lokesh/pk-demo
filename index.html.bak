        }

        .ft h4 {
            font-family: var(--serif);
            font-weight: 500;
            font-size: 19px;
            color: #d9b36b;
            margin: 0 0 16px
        }

        .ft ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: 11px
        }

        .ft li,
        .ft li a {
            font-size: 14.5px;
