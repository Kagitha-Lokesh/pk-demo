        }

        .ft-b {
            max-width: 1400px;
            margin: clamp(26px, 3.5vw, 44px) auto 0;
            border-top: 1px solid #ffffff22;
            padding: 18px 0;
            display: flex;
            justify-content: space-between;
            gap: 10px 20px;
            flex-wrap: wrap;
            font-size: 13px;
            color: #cdbda4
        }

        /* ===== Tablet ===== */
        @media(max-width:1000px) {
            .fc {
                grid-template-columns: repeat(2, 1fr)
            }

            .pr6 {
                grid-template-columns: repeat(3, 1fr);
                row-gap: 30px
            }

            .ft-g {
                grid-template-columns: 1fr 1fr
            }

            .ft-g>div:first-child,
            .ft .soc {
                grid-column: 1/-1
            }

            .pr6 .n {
                margin-left: -8%
            }
        }
    </style>
    <style id="update-4">
        /* ===== Logo (header) ===== */
        header .hd {
            height: auto !important;
            min-height: 0 !important;
            padding-top: 8px;
            padding-bottom: 8px;
            align-items: center
        }

        header .logo {
            flex: none;
            display: block;
            margin: 0
        }

        header .logo img.brand {
            display: block !important;
            height: clamp(88px, 7.2vw, 112px) !important;
            width: auto !important;
            aspect-ratio: 560/565;
            mix-blend-mode: normal !important;
            filter: drop-shadow(0 0 .6px rgba(70, 35, 10, .55))
        }

        @media(max-width:700px) {
            header .hd {
                padding: 8px 14px 12px
            }

            header .logo {
                margin: 0 auto
            }

            header .logo img.brand {
                height: 72px !important
            }
        }

        /* ===== Footer logo: no box ===== */
        .ft .ft-logo {
            display: inline-block;
            background: none;
            border: 0;
            box-shadow: none;
            padding: 0;
            margin: 0 0 16px;
            border-radius: 0
        }

        .ft .ft-logo img {
            width: clamp(160px, 17vw, 220px);
            height: auto;
            max-width: 100%;
            background: none;
            border: 0;
            box-shadow: none
        }

        /* ===== Art section image: same source, fits all screens ===== */
        .ab-img img {
            aspect-ratio: 4/5;
            object-fit: cover;
            object-position: 50% 10%;
            width: 100%;
            height: auto
        }

        @media(max-width:700px) {
            .ab-img img {
                aspect-ratio: 3/4;
                object-position: 50% 12%
            }
        }

        /* ===== Polish ===== */
        html {
            scroll-behavior: smooth
        }

        #new,
        #cat,
        #col,
        #story,
        #craft,
        #store {
            scroll-margin-top: 110px
        }

        :focus-visible {
            outline: 2px solid #c9a15c;
            outline-offset: 2px
        }

        .p>img {
            transition: transform .6s
        }

        .p,
        .btn,
        .wa,
        .add {
            transition: box-shadow .25s, transform .25s, background .2s, color .2s
        }

        @media(hover:hover) {
            .p:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 22px rgba(70, 35, 25, .18)
            }

            .p:hover>img {
                transform: scale(1.06)
            }

            .wa:hover {
                background: #0a3a22
            }
        }

        .heart {
            cursor: pointer
        }

