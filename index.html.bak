<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Purnima Kalamkari – Handcrafted Kalamkari</title>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Lato:wght@400;700&display=swap">
    <style>
        :root {
            --maroon: #84151b;
            --bar: #7a1118;
            --cream: #fdf7eb;
            --hdr: #fbf3e8;
            --card: #fbf5e7;
            --ink: #2a1a14;
            --mute: #7a6a5e;
            --line: #e8d9c0;
            --serif: "Playfair Display", Georgia, serif;
            --sans: Lato, system-ui, sans-serif;
            box-sizing: border-box;
            padding-top: env(safe-area-inset-top, 0px);
            padding-bottom: env(safe-area-inset-bottom, 0px)
        }

        html {
            scroll-padding-top: env(safe-area-inset-top, 0px);
            scroll-behavior: smooth
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: var(--cream);
            color: var(--ink);
            font-family: var(--sans);
            font-size: 14px
        }

        a {
            color: inherit;
            text-decoration: none
        }

        button {
            font: inherit;
            cursor: pointer
        }

        img {
            display: block
        }

        .wrap {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 20px
        }

        .m-only {
            display: none !important
        }

        .top {
            background: var(--bar);
            color: #fff;
            font-size: 12px
        }

        .top .wrap {
            display: flex;
            justify-content: space-between;
            align-items: center;
            min-height: 32px
        }

        .top .l {
            display: flex;
            gap: 30px
        }

        .top .mb {
            display: none
        }

        header {
            background: var(--hdr);
            position: sticky;
            top: env(safe-area-inset-top, 0px);
            z-index: 30
        }

        .hd {
            display: flex;
            align-items: center;
            gap: 26px;
            padding: 6px 20px;
            max-width: 1240px;
            margin: 0 auto
        }

        .logo img {
            height: 62px;
            mix-blend-mode: multiply
        }

        .mid {
            flex: 1;
            min-width: 0
        }

        .search {
            display: flex;
            align-items: center;
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 0 14px;
            height: 34px;
            margin: 0 0 6px;
            max-width: 380px;
            margin-left: 0
        }

        .search input {
            flex: 1;
            border: 0;
            background: none;
            outline: 0;
            color: var(--ink);
            font: inherit;
            font-size: 12px;
            min-width: 0
        }

        .mid {
            padding-left: 12px
        }

        nav.main {
            display: flex;
            gap: 32px;
            font-size: 13px;
            margin-left: -12px;
            padding-left: 0
        }

        nav.main a {
            padding: 3px 0 5px;
            border-bottom: 2px solid transparent
        }

        nav.main a.on {
            color: var(--maroon);
            border-color: var(--maroon)
        }

        .ic {
            background: none;
            border: 0;
            color: var(--ink);
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 11px;
            gap: 2px;
            position: relative;
            padding: 4px
        }

        .ic svg {
            width: 24px;
            height: 24px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.6
        }

        .badge {
            position: absolute;
            top: -2px;
            right: -2px;
            background: var(--maroon);
            color: #fff;
            border-radius: 50%;
            width: 16px;
            height: 16px;
            font-size: 10px;
            display: flex;
            align-items: center;
            justify-content: center
        }

        .wa {
            background: #0d4a2c;
            color: #fff;
            padding: 12px 18px;
            border-radius: 4px;
            font-size: 13px;
            white-space: nowrap
        }

        .hero {
            position: relative;
            overflow: hidden;
            background: var(--cream);
            height: clamp(380px, 31vw, 470px)
        }

        .deco {
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            mix-blend-mode: multiply
        }

        .ph {
            position: absolute;
            right: 0;
            top: 0;
            height: 100%
        }

        .ph img.d {
            height: 100%;
            width: auto;
            -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%);
            mask-image: linear-gradient(90deg, transparent, #000 22%)
        }

        .arrows button {
            position: absolute;
            top: 94%;
            transform: translate(-50%, -50%);
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 0;
            background: #fff;
            box-shadow: 0 1px 4px #0004;
            font-size: 20px;
            line-height: 1;
            padding: 0 0 3px
        }

        .txt {
            position: relative;
            z-index: 2;
            padding-top: 30px
        }

        .sl {
            display: none
        }

        .sl.on {
            display: block;
            animation: f .6s
        }

        @keyframes f {
            from {
                opacity: .2
            }

            to {
                opacity: 1
            }
        }

        .eyebrow {
            font-family: var(--serif);
            font-size: 12px;
            letter-spacing: 2.5px;
            color: #6b5a4a
        }

        .hero h1 {
            font-family: var(--serif);
            font-size: clamp(44px, 5.6vw, 78px);
            line-height: .95;
            margin: 14px 0 12px;
            font-weight: 500
        }

        .hero h1 b {
            color: var(--maroon);
            display: block;
            font-weight: 700
        }

        .hero p {
            font-family: var(--serif);
            font-size: 18px;
            margin: 0 0 20px
        }

        .btn {
            background: var(--maroon);
            color: #fff;
            padding: 13px 28px;
            border-radius: 3px;
            font-family: var(--serif);
            font-size: 15px;
            display: inline-block
        }

        .dots {
            position: absolute;
            left: 52%;
            bottom: 12px;
            display: flex;
            gap: 6px;
            z-index: 3
        }

        .dots b {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #fffa;
            cursor: pointer
        }

        .dots b.on {
            background: var(--maroon)
        }

        .feat {
            display: flex;
            margin-top: -62px;
            position: relative;
            z-index: 3;
            max-width: 1240px;
            margin-left: auto;
            margin-right: auto;
            padding: 0 20px 0 20px;
            height: 62px;
            pointer-events: none
        }

        .feat div {
            width: 100px;
            text-align: center;
            font-size: 11px;
            color: var(--mute);
            font-family: var(--serif);
            border-right: 1px solid #d9c7a8;
            padding: 0 4px
        }

        .feat div:last-child {
            border: 0
        }

        .feat img {
            width: 30px;
            margin: 0 auto 5px;
            mix-blend-mode: multiply
        }

        .sec {
            padding: 20px 0 4px
        }

        .sh {
            display: flex;
            align-items: baseline;
            gap: 14px;
            margin-bottom: 10px
        }

        .sh h2 {
            font-family: var(--serif);
            font-size: 24px;
            margin: 0;
            font-weight: 500
        }

        .sh p {
            margin: 0;
            color: var(--mute);
            font-size: 13px;
            font-family: var(--serif)
        }

        .sh a {
            margin-left: auto;
            color: var(--maroon);
            font-size: 11px;
            font-weight: 700
        }

        .cats {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px
        }

        .cat {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 6px;
            overflow: hidden;
            text-align: center;
            transition: .2s
        }

        .cat:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 18px #0002
        }

        .cat img {
            width: 100%;
            height: auto;
            aspect-ratio: 188/115;
            object-fit: cover
        }

        .cat b {
            display: block;
            font-family: var(--serif);
            font-weight: 500;
            font-size: 15px;
            padding: 6px 0 0
        }

        .cat small {
            color: var(--maroon);
            font-size: 11px;
            display: block;
            padding-bottom: 8px
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 14px
        }

        .p {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 6px;
            overflow: hidden;
            position: relative
        }

        .p>img {
            width: 100%;
            aspect-ratio: 150/92;
            object-fit: cover
        }

        .tag {
            position: absolute;
            top: 8px;
            left: 8px;
            background: var(--maroon);
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            padding: 3px 7px;
            border-radius: 2px;
            letter-spacing: .5px
        }

        .tag.b {
            background: #c96205
        }

        .heart {
            position: absolute;
            top: 7px;
            right: 7px;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 0;
            background: #fffd;
            color: var(--ink);
            font-size: 14px;
            padding: 0
        }

        .heart.on {
            color: var(--maroon)
        }

        .pi {
            padding: 8px 10px 10px
        }

        .pi h3 {
            font-family: var(--serif);
            font-size: 12px;
            margin: 0 0 2px;
            font-weight: 500
        }

        .pi .v {
            font-size: 11px;
            color: var(--mute)
        }

        .pi .pr {
            font-family: var(--serif);
            color: var(--maroon);
            font-weight: 700;
            font-size: 15px;
            margin: 3px 0
        }

        .pi .m {
            font-size: 10px;
            color: var(--mute);
            margin-bottom: 7px
        }

        .add {
            width: 100%;
            background: none;
            border: 1px solid var(--maroon);
            color: var(--maroon);
            border-radius: 3px;
            padding: 5px;
            font-size: 11px
        }

        .add:hover {
            background: var(--maroon);
            color: #fff
        }

        .cols {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin-bottom: 40px
        }

        .cols a img {
            width: 100%;
            height: auto;
            border-radius: 6px
        }

        .cols a:hover {
            filter: brightness(1.08)
        }

        .empty {
            grid-column: 1/-1;
            text-align: center;
            color: var(--mute);
            padding: 20px
        }

        .toast {
            position: fixed;
            left: 50%;
            bottom: calc(20px + env(safe-area-inset-bottom, 0px));
            transform: translate(-50%, 90px);
            background: var(--ink);
            color: var(--cream);
            padding: 10px 18px;
            border-radius: 6px;
            font-size: 13px;
            transition: .3s;
            z-index: 60
        }

        .toast.on {
            transform: translate(-50%, 0)
        }

        .drawer {
            position: fixed;
            inset: 0 25% 0 0;
            max-width: 300px;
            background: var(--cream);
            z-index: 50;
            transform: translateX(-105%);
            transition: .3s;
            padding: 70px 24px;
            display: flex;
            flex-direction: column;
            gap: 18px;
            font-family: var(--serif);
            font-size: 18px
        }

        .drawer.on {
            transform: none
        }

        @media(max-width:1000px) {
            .grid {
                grid-template-columns: repeat(3, 1fr)
            }

            .cats {
                grid-template-columns: repeat(3, 1fr)
            }

            .cols {
                grid-template-columns: repeat(2, 1fr)
            }

            .wa,
            nav.main {
                display: none
            }

            .top .l span:nth-child(n+2) {
                display: none
            }
        }

        @media(max-width:700px) {
            .d-only {
                display: none !important
            }

            .m-only {
                display: block !important
            }

            .top {
                background: var(--bar)
            }

            .top .l,
            .top .r {
                display: none
            }

            .top .mb {
                display: flex;
                justify-content: space-between;
                width: 100%;
                padding: 11px 14px;
                font-size: 13px
            }

            header {
                background: #fff
            }

            .hd {
                flex-wrap: wrap;
                gap: 8px;
                padding: 8px 14px
            }

            .hd .ic span:not(.badge) {
                display: none
            }

            .logo {
                margin: 0 auto
            }

            .logo img {
                height: 46px
            }

            .mid {
                order: 5;
                flex: 1 0 100%;
                padding: 0
            }

            .search {
                max-width: none;
                margin: 0;
                display: flex
            }

            .hd .burger {
                order: -1;
                display: flex !important
            }

            .fl {
                background: none;
                border: 0;
                color: var(--ink);
                padding: 0 0 0 10px;
                font-size: 18px
            }

            .hero {
                height: 268px
            }

            .ph {
                display: block
            }

            .ph img.m {
                height: 100%;
                width: auto;
                -webkit-mask-image: linear-gradient(90deg, transparent, #000 25%);
                mask-image: linear-gradient(90deg, transparent, #000 25%)
            }

            .arrows {
                display: none
            }

            .txt {
                padding-top: 26px
            }

            .hero h1 {
                font-size: 36px;
                margin: 0 0 8px
            }

            .hero p {
                font-size: 12px;
                max-width: 160px;
                margin-bottom: 16px
            }

            .btn {
                font-size: 13px;
                padding: 11px 20px
            }

            .dots {
                left: 20px;
                bottom: 14px
            }

            .feat {
                margin: 0;
                height: auto;
                padding: 12px 8px;
                background: #fff;
                justify-content: space-between;
                pointer-events: auto
            }

            .feat div {
                flex: 1;
                width: auto;
                font-size: 10px
            }

            .sh h2 {
                font-size: 20px
            }

            .sh p {
                display: none
            }

            .cats {
                display: flex;
                overflow-x: auto;
                gap: 14px;
                padding-bottom: 4px
            }

            .cat {
                flex: 0 0 62px;
                border: 0;
                background: none;
                border-radius: 0
            }

            .cat img {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                margin: 0 auto;
                aspect-ratio: 1;
                border: 2px solid #c9a15c
            }

            .cat b {
                font-family: var(--sans);
                font-weight: 400;
                font-size: 11px
            }

            .cat small {
                display: none
            }

            .grid {
                display: flex;
                overflow-x: auto;
                gap: 10px;
                padding-bottom: 6px
            }

            .p {
                flex: 0 0 112px
            }

            .pi h3 {
                font-size: 11px
            }

            .pi .pr {
                font-size: 14px
            }

            .add {
                display: none
            }

            .cols {
                display: flex;
                overflow-x: auto;
                gap: 10px
            }

            .cols a {
                flex: 0 0 auto
            }

            .cols a img {
                height: 86px;
                width: auto
            }
        }

        @media(prefers-reduced-motion:reduce) {
            * {
                animation: none !important;
                transition: none !important
            }

            html {
                scroll-behavior: auto
            }
        }
    </style>
    <style>
        @media(max-width:700px) {
            .srow {
                display: flex;
                gap: 8px
            }

            .eyebrow {
                display: none
            }

            .top .mb {
                padding: 7px 16px;
                font-size: 12.5px;
                background: #731515
            }

            .top {
                background: #731515
            }

            header {
                background: #f9f6e7
            }

            .hd {
                padding: 10px 16px 13px;
                gap: 8px;
                position: relative
            }

            .hd .burger {
                width: 72px;
                align-items: flex-start;
                padding-left: 0
            }

            .hd .ic svg {
                width: 23px;
                height: 23px;
                stroke-width: 1.7
            }

            .logo {
                margin: 0 auto
            }

            .logo img {
                height: 52px;
                mix-blend-mode: multiply
            }

            .badge {
                background: #b81c1c;
                top: -1px;
                right: -3px
            }

            .search {
                height: 34px;
                border-radius: 8px;
                background: #fcf9f1;
                border: 1px solid #e5d9c4;
                flex: 1;
                padding: 0 12px;
                gap: 9px
            }

            .search input {
                font-size: 11px;
                font-family: Roboto, var(--sans)
            }

            .search input::placeholder {
                color: #8a7f72
            }

            .fl {
                width: 34px;
                height: 34px;
                flex: none;
                border: 1px solid #e5d9c4;
                border-radius: 8px;
                background: #fcf9f1;
                padding: 0;
                display: flex !important;
                align-items: center;
                justify-content: center
            }

            .hero {
                height: auto;
                aspect-ratio: 673/454;
                container-type: inline-size;
                background: #f6ebd9
            }

            .deco.m-only {
                height: auto;
                width: 35.7%;
                top: 0;
                left: 0
            }

            .ph img.m {
                -webkit-mask-image: linear-gradient(90deg, transparent, #000 30%);
                mask-image: linear-gradient(90deg, transparent, #000 30%)
            }

            .txt {
                padding: 19cqw 0 0 6.2cqw
            }

            .hero h1 {
                font-size: 8.7cqw;
                line-height: 1.02;
                margin: 0 0 2.8cqw;
                font-weight: 500
            }

            .hero h1 b {
                font-weight: 500;
                color: #6e1519
            }

            .hero p {
                font-size: 3cqw;
                line-height: 1.4;
                max-width: 42cqw;
                margin: 0 0 3.6cqw
            }

            .btn {
                font-size: 3.1cqw;
                padding: 2.2cqw 0;
                width: 43cqw;
                text-align: center;
                border-radius: .8cqw;
                background: #7a1519
            }

            .dots {
                left: 6.2cqw;
                bottom: 3cqw
            }

            .feat {
                background: #f8f5e6;
                padding: 14px 0 12px
            }

            .feat div {
                font-size: 9.5px;
                color: #7b6c60;
                border-right: 1px solid #e6dac4
            }

            .feat img.m-only {
                width: 30px;
                height: 30px;
                margin: 0 auto 6px
            }

            main.wrap {
                padding: 0 14px;
                background: #f8f5e6
            }

            body {
                background: #f8f5e6
            }

            .sh h2 {
                font-size: 22px;
                font-weight: 500
            }

            .sh a {
                font-size: 11.5px
            }

            .sec {
                padding: 14px 0 4px
            }

            #cat {
                padding-bottom: 16px;
                border-bottom: 1px solid #eadfca
            }

            #new {
                padding-top: 20px
            }

            .cats {
                display: grid;
                grid-template-columns: repeat(5, 1fr);
                gap: 0;
                overflow: visible
            }

            .cat {
                flex: none;
                transform: none !important;
                box-shadow: none !important
            }

            .cat img.m-only {
                width: 62px;
                height: 62px;
                border-radius: 50%;
                margin: 0 auto 8px;
                aspect-ratio: 1;
                border: 1px solid #e0cfae
            }

            .cat b {
                font-family: var(--serif);
                font-size: 12px;
                padding: 0
            }

            .grid {
                gap: 9px
            }

            .p {
                flex: 0 0 calc((100% - 18px)/3);
                border-radius: 10px;
                background: #fcf8ef;
                border: 1px solid #eadfca;
                box-shadow: 0 1px 4px #0001
            }

            .p>img {
                aspect-ratio: 190/168;
                object-fit: cover
            }

            .pi {
                padding: 7px 6px 9px
            }

            .pi h3 {
                font-size: 11px
            }

            .pi .v {
                font-family: var(--serif);
                font-size: 9.5px
            }

            .pi .pr {
                font-size: 15px;
                margin: 2px 0 3px
            }

            .pi .m {
                font-family: var(--serif);
                font-size: 8.5px;
                margin: 0
            }

            .tag {
                top: 7px;
                left: 7px;
                font-size: 8px;
                padding: 3px 6px
            }

            .p.bk .tag {
                display: none
            }

            .p.bk .heart {
                top: 0;
                right: 0;
                width: 28px;
                height: 28px;
                background: transparent;
                color: transparent
            }

            .p.bk .heart.on {
                color: var(--maroon);
                background: radial-gradient(circle, #fff 0 9px, transparent 9.5px)
            }

            .cols {
                gap: 10px
            }

            .cols a img {
                height: 92px;
                width: auto;
                border-radius: 8px
            }
        }
    </style>
    <style>
        @media(max-width:700px) {
            .logo img.m-only {
                mix-blend-mode: normal
            }

            .deco.m-only {
                mix-blend-mode: normal
            }

        }
    </style>
    <style>
        .badge[hidden] {
            display: none
        }

        .ph img.d {
            aspect-ratio: 635/321;
            object-fit: cover
        }

        .ph img[data-s]:not(.on) {
            display: none !important
        }

        @media(max-width:700px) {
            .top .wrap {
                min-height: 0;
                padding: 0
            }

            .top .mb span:not(:nth-child(2)) {
                font-size: 20px;
                line-height: 1
            }

            .txt {
                padding: 19cqw 0 0 6.2cqw
            }

            .hero h1 {
                font-size: 7.6cqw
            }

            .hero p {
                font-size: 2.9cqw;
                max-width: 40cqw
            }

            .btn {
                width: 40cqw;
                font-size: 3cqw
            }

            .ph img[data-s] {
                height: 100%;
                width: 52cqw;
                aspect-ratio: auto;
                object-fit: cover;
                object-position: 60% center;
                -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%);
                mask-image: linear-gradient(90deg, transparent, #000 40%)
            }

            .deco.m-only {
                width: 35.7%;
                height: auto
            }
        }
    </style>
    <style>
        @media(min-width:701px) {
            :root {
                --cream: #fdf6ea;
                --hdr: #fcf4e9;
                --u: calc(min(100vw, 1240px)/1115)
            }

            body {
                background: var(--cream)
            }

            .top,
            .top .mb {
                background: #731419
            }

            .top .wrap,
            .hd {
                max-width: 1240px;
                padding-left: 6.4%;
                padding-right: 3%
            }

            .top .wrap {
                min-height: 32px
            }

            .top .l {
                gap: 0
            }

            .top .l span {
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 0 20px;
                border-right: 1px solid #ffffff40;
                line-height: 14px;
                font-size: 11.5px
            }

            .top .l span:first-child {
                padding-left: 0
            }

            .top .l span:last-child {
                border: 0
            }

            .top .r {
                display: flex;
                align-items: center;
                gap: 9px;
                font-size: 11.5px
            }

            header {
                background: var(--hdr)
            }

            .hd {
                gap: 30px;
                padding-top: 0;
                padding-bottom: 0;
                height: calc(76*var(--u));
                min-height: 68px
            }

            .logo img {
                height: calc(64*var(--u));
                mix-blend-mode: normal
            }

            .mid {
                flex: 0 1 calc(444*var(--u));
                min-width: 0;
                margin-left: auto;
                padding: 0
            }

            .search {
                max-width: none;
                width: calc(380*var(--u));
                margin: 0 0 5px auto;
                height: 30px;
                border-radius: 5px;
                background: #fbf8f0;
                border: 1px solid #e8dcc6
            }

            nav.main {
                justify-content: flex-end;
                gap: calc(26*var(--u));
                margin: 0;
                padding: 0;
                font-size: 13px;
                color: #3a2a22
            }

            .wa {
                display: flex;
                align-items: center;
                gap: 8px;
                height: 34px;
                padding: 0 17px;
                font-weight: 700;
                font-size: 12px
            }

            .hero {
                max-width: 1240px;
                margin: 0 auto;
                height: auto;
                aspect-ratio: 1115/343;
                background: #f8ecde
            }

            .hero .txt {
                max-width: none;
                margin: 0;
                padding: calc(31*var(--u)) 0 0 calc(93*var(--u))
            }

            .eyebrow {
                font-size: calc(11.5*var(--u));
                letter-spacing: .22em;
                line-height: 1.2;
                color: #8a6f45
            }

            .hero h1 {
                font-size: calc(66*var(--u));
                line-height: 1.06;
                margin: calc(5*var(--u)) 0 calc(2*var(--u))
            }

            .hero p {
                font-size: calc(16.5*var(--u));
                margin: 0 0 calc(13*var(--u));
                max-width: none
            }

            .btn {
                font-size: calc(14*var(--u));
                padding: calc(10*var(--u)) calc(28*var(--u));
                border-radius: 3px
            }

            .deco.d-only {
                height: 100%;
                width: auto;
                mix-blend-mode: normal
            }

            .ph img.d {
                aspect-ratio: 635/343;
                object-fit: cover
            }

            .ph img.d[data-s="0"] {
                -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%);
                mask-image: linear-gradient(90deg, transparent, #000 8%)
            }

            .ph img.d:not([data-s="0"]) {
                -webkit-mask-image: linear-gradient(90deg, transparent, #000 30%);
                mask-image: linear-gradient(90deg, transparent, #000 30%)
            }

            .arrows button {
                top: 88.3%;
                width: calc(28*var(--u));
                height: calc(28*var(--u));
                min-width: 24px;
                min-height: 24px;
                font-size: 16px;
                padding: 0 0 2px
            }

            .dots {
                left: 50.7%;
                bottom: calc(12*var(--u))
            }

            .dots b {
                width: 6px;
                height: 6px
            }

            .feat {
                max-width: 1240px;
                margin: calc(-65*var(--u)) auto 0;
                padding: 0 0 0 calc(77*var(--u));
                height: calc(48*var(--u))
            }

            .feat div {
                width: calc(93*var(--u));
                padding: 0;
                font-size: calc(10*var(--u));
                border-right: 1px solid #dccdb0
            }

            .feat img.d-only {
                width: calc(28*var(--u));
                margin: 0 auto 4px
            }

            main.wrap {
                max-width: 1240px;
                padding: 0 5.4% 0 6.4%
            }

            .sec {
                padding: calc(12*var(--u)) 0 0
            }

            .sh {
                margin-bottom: calc(9*var(--u))
            }

            .sh h2 {
                font-size: calc(21*var(--u));
                font-weight: 600
            }

            .sh a {
                font-size: calc(10.5*var(--u))
            }

            #new .sh {
                display: grid;
                grid-template-columns: 1fr auto;
                align-items: center;
                gap: 0
            }

            #new .sh p {
                grid-column: 1;
                grid-row: 2;
                margin-top: 2px
            }

            #new .sh a {
                grid-column: 2;
                grid-row: 1
            }

            #new h2 {
                color: var(--maroon)
            }

            .cats {
                gap: calc(15*var(--u))
            }

            .cat {
                background: #fbf4e6;
                border-color: #eadcc3;
                border-radius: 8px
            }

            .cat img {
                aspect-ratio: 188/116
            }

            .cat b {
                font-size: calc(13.5*var(--u));
                font-weight: 500;
                padding-top: calc(7*var(--u))
            }

            .cat small {
                font-size: calc(10.5*var(--u))
            }

            .grid {
                gap: calc(9*var(--u))
            }

            .p {
                border-radius: 8px;
                background: #fffaf1;
                border-color: #eadcc3
            }

            .p>img {
                aspect-ratio: 154/114
            }

            .p .tag {
                display: none
            }

            .p .heart {
                top: 0;
                right: 3px;
                width: 26px;
                height: 26px;
                background: transparent;
                color: transparent
            }

            .p .heart.on {
                color: var(--maroon);
                background: radial-gradient(circle, #fff 0 9px, transparent 9.5px)
            }

            .pi {
                padding: calc(8*var(--u)) 9px 9px
            }

            .pi h3 {
                font-family: var(--sans);
                font-weight: 700;
                font-size: calc(11*var(--u));
                color: #2a1a14
            }

            .pi .v {
                font-size: calc(10.5*var(--u))
            }

            .pi .pr {
                font-size: calc(15*var(--u));
                color: #b3141c;
                margin: 2px 0
            }

            .pi .m {
                font-family: var(--serif);
                font-size: calc(9.5*var(--u));
                margin: 0
            }

            .p .add {
                position: absolute;
                left: 8px;
                right: 8px;
                top: calc(114*var(--u) - 34px);
                width: auto;
                opacity: 0;
                background: var(--maroon);
                color: #fff;
                border: 0;
                padding: 6px;
                transition: .2s
            }

            .p:hover .add {
                opacity: 1
            }
        }
    </style>
    <style>
        @media(min-width:701px) {
            nav.main a {
                white-space: nowrap
            }

            .hero h1 b {
                font-size: 1.08em
            }

            .hero p {
                font-size: calc(18.5*var(--u))
            }

            #cat {
                padding-top: calc(24*var(--u))
            }

            .pi h3 {
                font-size: calc(10.5*var(--u));
                white-space: nowrap
            }
        }
    </style>
    <style>
        @media(min-width:701px) {
            nav.main {
                justify-content: space-between;
                gap: 0;
                font-size: 12.5px;
                width: 100%
            }

            .logo {
                flex: none
            }
        }
    </style>
    <style>
        @media(min-width:701px) {
            :root {
                --u: calc(100vw/1115);
                --h: calc(min(100vw, 1500px)/1115)
            }

            body {
                overflow-x: clip
            }

            .top .wrap,
            .hd,
            .hero,
            .feat,
            main.wrap {
                max-width: none
            }

            .top .wrap {
                min-height: calc(32*var(--h))
            }

            .hd {
                height: calc(76*var(--h))
            }

            .logo img {
                height: calc(64*var(--h))
            }

            .mid {
                flex: 0 1 calc(444*var(--h))
            }

            .search {
                width: calc(380*var(--h));
                height: calc(30*var(--h))
            }

            nav.main {
                font-size: calc(12.5*var(--h))
            }
        }
    </style>
    <style id="update-2026">
        /* ===== HERO: banner 2 + 3 (banner 1 rules untouched) ===== */
        .bn {
            display: none;
            position: absolute;
            right: 0;
            top: 0;
            height: 100%;
            overflow: hidden
        }

        .bn.on {
            display: block;
            animation: f .6s
        }

        .bn img {
            display: block
        }

        .bn .fg {
            height: 100%;
            width: 100%;
            object-fit: contain;
            image-rendering: auto
        }

        .arrows {
            position: absolute;
            inset: 0;
            z-index: 4;
            pointer-events: none
        }

        .arrows button {
            pointer-events: auto
        }

        @media(min-width:701px) {

            /* arrows keep the exact position they had over banner 1 */
            #pv {
                left: 92.03%
            }

            #nx {
                left: 95.22%
            }

            /* banner 2: photo shown whole (3:2), fades softly into the cream panel */
            .bn.b2 {
                aspect-ratio: 3/2;
                -webkit-mask-image: linear-gradient(90deg, transparent, #000 24%);
                mask-image: linear-gradient(90deg, transparent, #000 24%)
            }

            /* banner 3: portrait photo shown whole, on a soft colour-matched backdrop */
            .bn.b3 {
                left: 43.05%;
                background: linear-gradient(90deg, rgba(241, 224, 208, 0) 0, #f1e0d0 26%, #e6cbb8 62%, #d9b9a5 100%)
            }

            .bn.b3 .fg {
                position: absolute;
                z-index: 1;
                top: 0;
                right: 27.2%;
                height: 100%;
                width: auto;
                aspect-ratio: 365/547;
                box-shadow: 0 0 26px rgba(70, 35, 25, .30)
            }
        }

        @media(max-width:700px) {
            .bn {
                width: 56cqw
            }

            .bn.b2 {
                -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%);
                mask-image: linear-gradient(90deg, transparent, #000 10%)
            }

            .bn.b2 .fg {
                object-fit: cover;
                object-position: 55.8% 50%
            }

            .bn.b3 {
                width: 50cqw;
                background: linear-gradient(90deg, rgba(241, 224, 208, 0) 0, #f1e0d0 22%, #e2c4b0 100%)
            }

            .bn.b3 .fg {
                position: absolute;
                z-index: 1;
                right: 0;
                top: 0;
                height: 100%;
                width: auto;
                aspect-ratio: 365/547;
                object-fit: contain;
                box-shadow: 0 0 14px rgba(70, 35, 25, .28)
            }
        }

        /* ===== NEW ARRIVALS: always-visible Add to Cart ===== */
        .p {
            display: flex;
            flex-direction: column
        }

        .p>img {
            flex: none
        }

        .pi {
            flex: 1;
            display: flex;
            flex-direction: column
        }

        .pi .m {
            padding-bottom: 9px
        }

        .p .add {
            position: static;
            opacity: 1;
            display: block;
            flex: none;
            width: 100%;
            margin-top: auto;
            min-height: 34px;
            padding: 0 8px;
            background: var(--maroon);
            color: #fdf6ea;
            border: 1px solid var(--maroon);
            border-radius: 4px;
            font-family: var(--serif);
            font-size: 12.5px;
            font-weight: 500;
            letter-spacing: .02em;
            line-height: 1.1;
            white-space: nowrap;
            transition: background .2s, transform .15s;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation
        }

        .p .add:hover {
            background: #5f0e13;
            color: #fff
        }

        .p .add:active {
            transform: scale(.97)
        }

        .p .add:focus-visible {
            outline: 2px solid #c9a15c;
            outline-offset: 2px
        }

        @media(min-width:701px) {
            .p .add {
                min-height: calc(30*var(--u));
                min-height: max(32px, calc(30*var(--u)));
                font-size: max(12px, calc(11.5*var(--u)))
            }
        }

        @media(max-width:700px) {
            .pi {
                padding: 7px 6px 8px
            }

            .p .add {
                min-height: 38px;
                font-size: 12px;
                padding: 0 4px;
                border-radius: 5px
            }
        }

        @media(max-width:340px) {
            .p .add {
                font-size: 11px;
                letter-spacing: 0
            }
        }

        .badge.bump {
            animation: bump .35s
        }

        @keyframes bump {
            40% {
                transform: scale(1.35)
            }
        }

        .toast {
            width: max-content;
            max-width: calc(100vw - 32px);
            text-align: center;
            line-height: 1.35;
            opacity: 0;
            pointer-events: none
        }

        .toast.on {
            opacity: 1
        }

        /* ===== MOBILE: Shop by Category = one swipeable row of circles ===== */
        @media(max-width:700px) {
            .cats {
                display: flex;
                flex-wrap: nowrap;
                align-items: flex-start;
                gap: 12px;
                overflow-x: auto;
                overflow-y: hidden;
                margin: 0 -14px;
                padding: 11px 14px 12px;
                scroll-snap-type: x proximity;
                scroll-padding-left: 14px;
                -webkit-overflow-scrolling: touch;
                overscroll-behavior-x: contain;
                scrollbar-width: none;
                -ms-overflow-style: none
            }

            .cats::-webkit-scrollbar {
                display: none;
                width: 0;
                height: 0
            }

            .cat {
                flex: 0 0 74px;
                display: block;
                overflow: visible;
                scroll-snap-align: start;
                text-align: center
            }

            .cat img.m-only {
                width: 64px;
                height: 64px;
                margin: 0 auto 9px;
                border: 0;
                border-radius: 50%;
                object-fit: cover;
                aspect-ratio: 1;
                box-shadow: 0 0 0 2.5px #f8f5e6, 0 0 0 4px #c9a15c
            }

            .cat b {
                white-space: nowrap;
                font-size: 12px;
                line-height: 1.2
            }

            #cat {
                padding-bottom: 6px
            }
        }
    </style>
    <style id="update-3">
        /* ===== Banner 3: wider & bigger photo ===== */
        @media(min-width:701px) {
            .bn.b3 {
                left: 34%
            }

            .bn.b3 .fg {
                right: 14%;
                width: 47%;
                height: 100%;
                aspect-ratio: auto;
                object-fit: cover;
                object-position: 50% 20%
            }
        }

        @media(max-width:700px) {
            .bn.b3 {
                width: 62cqw;
                background: linear-gradient(90deg, rgba(241, 224, 208, 0) 0, #f1e0d0 20%, #e2c4b0 100%)
            }

            .bn.b3 .fg {
                right: 6%;
                width: 80%;
                height: 100%;
                aspect-ratio: auto;
                object-fit: cover;
                object-position: 50% 20%
            }
        }

        /* ===== New sections (same theme, fonts) ===== */
        .x {
            --pad: 6.4%;
            padding-left: var(--pad);
            padding-right: 5.4%
        }

        .x-in {
            max-width: 1400px;
            margin: 0 auto
        }

        .x-eyebrow {
            font-family: var(--sans);
            font-size: 11.5px;
            letter-spacing: .28em;
            text-transform: uppercase;
            color: #a67c3d;
            font-weight: 700;
            margin: 0 0 10px
        }

        .x h2.x-t {
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(26px, 3vw, 40px);
            line-height: 1.15;
            margin: 0 0 12px;
            color: var(--ink)
        }

        .x-sub {
            font-family: var(--serif);
            font-style: italic;
            color: var(--mute);
            font-size: clamp(15px, 1.4vw, 18px);
            margin: 0
        }

        .x-orn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            margin: 16px auto 0;
            color: #c9a15c;
            max-width: 260px
        }

        .x-orn i {
            flex: 1;
            height: 1px;
            background: #c9a15c
        }

        .x img {
            display: block
        }

        /* Featured Collections */
        #col {
            padding-bottom: 10px
        }

        .fc {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: clamp(12px, 1.4vw, 20px);
            margin: 12px 0 44px
        }

        .fc a {
            position: relative;
            display: block;
            border-radius: 10px;
            overflow: hidden;
            aspect-ratio: 4/3.1;
            background: #e9dcc4;
            box-shadow: 0 2px 10px rgba(60, 30, 20, .12);
            isolation: isolate
        }

        .fc img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .6s
        }

        .fc a::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(180deg, rgba(30, 10, 8, 0) 38%, rgba(30, 10, 8, .78) 100%)
        }

        .fc a:hover img {
            transform: scale(1.07)
        }

        .fc .cap {
            position: absolute;
            z-index: 2;
            left: 16px;
            right: 16px;
            bottom: 14px;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 10px;
            color: #fff
        }

        .fc .cap b {
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(17px, 1.7vw, 23px);
            line-height: 1.15;
            text-shadow: 0 1px 6px rgba(0, 0, 0, .45)
        }

        .fc .cap small {
            display: block;
            font-family: var(--sans);
            font-size: 11px;
            letter-spacing: .08em;
            opacity: .9;
            margin-top: 3px
        }

        .fc .go {
            flex: none;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #fff;
            color: var(--maroon);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            box-shadow: 0 2px 6px #0004;
            transition: .25s
        }

        .fc a:hover .go {
            background: var(--maroon);
            color: #fff;
            transform: translateX(3px)
        }

        /* About / Heritage */
        #story {
            background: #fbf1de;
            padding-top: clamp(36px, 5vw, 72px);
            padding-bottom: clamp(36px, 5vw, 72px)
        }

        .ab {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(24px, 4.5vw, 70px);
            align-items: center
        }

        .ab-img {
            position: relative
        }

        .ab-img img {
            width: 100%;
            aspect-ratio: 5/5.2;
            object-fit: cover;
            object-position: 50% 25%;
            border-radius: 12px;
            box-shadow: 0 14px 34px rgba(70, 35, 25, .25)
        }

        .ab-img::before {
            content: "";
            position: absolute;
            left: -14px;
            top: -14px;
            right: 14px;
            bottom: 14px;
            border: 2px solid #c9a15c;
            border-radius: 14px;
            z-index: -1
        }

        .ab-img {
            z-index: 0
        }

        .ab-q {
            border-left: 3px solid #c9a15c;
            padding-left: 14px;
            margin: 0 0 16px;
            font-family: var(--serif);
            font-style: italic;
            font-size: clamp(15px, 1.5vw, 19px);
            color: #6b3a2a
        }

        .ab p.tx {
            font-size: clamp(14px, 1.25vw, 16px);
            line-height: 1.75;
            color: #4a3a30;
            margin: 0 0 14px
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin: 22px 0 24px
        }

        .stats div {
            background: #fff9ee;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 14px 8px;
            text-align: center
        }

        .stats b {
            display: block;
            font-family: var(--serif);
            font-size: clamp(19px, 2vw, 26px);
            color: var(--maroon);
            font-weight: 600
        }

        .stats span {
            font-size: 11.5px;
            color: var(--mute);
            letter-spacing: .04em
        }

        /* From Nature to Fabric */
        #craft {
            padding-top: clamp(36px, 5vw, 70px);
            padding-bottom: clamp(36px, 5vw, 70px);
            text-align: center
        }

        .pr6 {
            --g: clamp(12px, 2vw, 28px);
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: var(--g);
            margin-top: 34px;
            position: relative
        }

        .pr6 .st {
            position: relative
        }

        .pr6 .ci {
            width: 100%;
            max-width: 230px;
            aspect-ratio: 1;
            margin: 0 auto 14px;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid #c9a15c;
            box-shadow: 0 0 0 5px #fdf6ea, 0 8px 20px rgba(70, 35, 25, .2);
            transition: transform .35s
        }

        .pr6 .st:hover .ci {
            transform: translateY(-5px) scale(1.03)
        }

        .pr6 .ci img {
            width: 100%;
            height: 100%;
            object-fit: cover
        }

        .pr6 .n {
            position: absolute;
            top: 2px;
            left: 50%;
            margin-left: -5.5%;
            transform: translateX(-90%);
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--maroon);
            color: #fff;
            font: 700 12px/28px var(--sans);
            z-index: 2;
            box-shadow: 0 2px 5px #0004
        }

        .pr6 h3 {
            font-family: var(--serif);
            font-weight: 600;
            font-size: clamp(15px, 1.4vw, 18px);
            margin: 0 0 5px;
            color: var(--ink)
        }

        .pr6 p {
            margin: 0 auto;
            max-width: 190px;
            font-size: clamp(12.5px, 1.05vw, 14px);
            line-height: 1.5;
            color: var(--mute)
        }

        /* Store / Address */
        #store {
            background: #fbf1de;
            padding-top: clamp(30px, 4vw, 60px);
            padding-bottom: clamp(36px, 5vw, 70px)
        }

        .stc {
            display: grid;
            grid-template-columns: 1.05fr 1fr;
            background: #fffdf8;
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(70, 35, 25, .12)
        }

        .stc .im {
            position: relative;
            min-height: 340px
        }

        .stc .im img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: 50% 30%
        }

        .stc .bd {
            padding: clamp(22px, 3.6vw, 52px)
        }

        .stc p.tx {
            font-size: clamp(14px, 1.25vw, 16px);
            line-height: 1.7;
            color: #4a3a30;
            margin: 0 0 16px
        }

        .row {
            display: flex;
            gap: 12px;
            margin: 0 0 10px;
            font-size: clamp(14px, 1.2vw, 15.5px);
            color: #4a3a30;
            line-height: 1.5
        }

        .row svg {
            flex: none;
            width: 20px;
            height: 20px;
            margin-top: 2px;
            stroke: var(--maroon);
            fill: none;
            stroke-width: 1.7
        }

        .row b {
            color: var(--ink)
        }

        .btns {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 22px
        }

        .b-g,
        .b-o {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 13px 24px;
            border-radius: 4px;
            font-weight: 700;
            font-size: 14px;
            min-height: 46px
        }

        .b-g {
            background: #0d4a2c;
            color: #fff
        }

        .b-g:hover {
            background: #0a3a22
        }

        .b-o {
            border: 1.5px solid var(--maroon);
            color: var(--maroon)
        }

        .b-o:hover {
            background: var(--maroon);
            color: #fff
        }

        /* Footer */
        footer.ft {
            background: #6e1117;
            color: #e9dcc8;
            padding: clamp(34px, 4.5vw, 60px) 5.4% 0 6.4%;
            border-top: 2px solid #b88a3e
        }

        .ft-g {
            display: grid;
            grid-template-columns: 1.5fr .9fr .9fr 1.1fr 1.3fr .9fr;
            gap: clamp(20px, 2.6vw, 40px);
            max-width: 1400px;
            margin: 0 auto
        }

        .ft .lg {
            display: inline-block;
            background: #fbf3e8;
            border-radius: 8px;
            padding: 6px 10px;
            margin-bottom: 16px
        }

        .ft .lg img {
            height: 54px;
            width: auto
        }

        .ft p {
            font-size: 14px;
            line-height: 1.7;
            margin: 0;
